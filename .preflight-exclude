# Advisory PR-Size Reporting - Excluded Files

# ==========================================

# Files matching these patterns are excluded from advisory PR-size reporting.

# Each line is a grep-compatible regex pattern.

#

# Why exclude these files?

# - Lock files are auto-generated and can be very large

# - License files are boilerplate and not meaningful code changes

#

# This file should match the exclusions in:

# SecPal/.github/.github/workflows/reusable-pr-size.yml

# Dependency lock files (auto-generated)

package-lock.json
composer.lock
yarn.lock
pnpm-lock.yaml

# License files (boilerplate)

^LICENSES/.*\.txt$

# Generated locale files (auto-generated by lingui)

src/locales/.*/messages\.js$
src/locales/.*/messages\.mjs$
src/locales/.*/messages\.po$
